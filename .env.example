# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholarship_pipeline?schema=public"

# Redis & BullMQ Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-123456"
JWT_EXPIRES_IN="7d"

# AI Configuration (Groq)
GROQ_API_KEY="gsk_placeholder_key_replace_me"
AI_MODEL="llama-3.3-70b-versatile"

# Publishing Configuration
PUBLISHING_WEBHOOK_URL="https://example.com/api/webhooks/publish"
PUBLISHING_WEBHOOK_SECRET="webhook-secret-key"

# Notifications Configuration
NOTIFICATION_WEBHOOK_URL="https://webhook.site/example"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Application Environment
NODE_ENV="development"
PORT=3000
SCHEDULER_INTERVAL_MIN=30

