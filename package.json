{
  "name": "apex-scholarship-automation-pipeline",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "next build",
    "start": "concurrently -k -p \"[{name}]\" -n \"NEXT,WORKER,SCHEDULER\" -c \"blue,green,magenta\" \"cross-env NODE_OPTIONS=--use-system-ca next start -H 0.0.0.0 -p 10000\" \"cross-env NODE_OPTIONS=--use-system-ca tsx src/pipeline/runtime/worker.ts\" \"cross-env NODE_OPTIONS=--use-system-ca tsx src/pipeline/runtime/scheduler.ts\"",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "worker": "cross-env NODE_OPTIONS=--use-system-ca tsx src/pipeline/runtime/worker.ts",
    "scheduler": "cross-env NODE_OPTIONS=--use-system-ca tsx src/pipeline/runtime/scheduler.ts",
    "api": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@swc/helpers": "^0.5.23",
    "@tailwindcss/postcss": "4.1.17",
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/pino": "^7.0.4",
    "@types/slug": "^5.0.9",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "axios": "1.7.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.41.0",
    "cheerio": "1.2.0",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "cron-parser": "^5.7.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "next": "16.2.6",
    "node-cron": "^4.6.0",
    "node-html-parser": "^9.0.1",
    "p-limit": "^7.3.1",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.0",
    "pg": "8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "postcss": "8.5.8",
    "prisma": "^7.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "^3.0.1",
    "slug": "^12.0.1",
    "string-similarity": "^4.0.4",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.3",
    "uuid": "^14.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "browserslist": "^4.28.8",
    "caniuse-lite": "1.0.30001600",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}
